# Leave LLM_BASE_URL and LLM_MODEL unset for simulation-only mode.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-model-name
LLM_API_KEY=

# tools uses structured calls. json sends a strict JSON action envelope.
LLM_MODE=tools
LLM_TOKEN_LIMIT_FIELD=max_completion_tokens

# Set both prices when using --max-cost-usd. Use 0 only for a free endpoint.
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=
